{
  "name": "servicepulse-android",
  "version": "1.0.0",
  "description": "ServicePulse - system services monitor for Android (Capacitor)",
  "main": "index.js",
  "scripts": {
    "sync": "node ../scripts/sync-web.js",
    "open": "npx cap open android",
    "build": "node ../scripts/sync-web.js && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "author": "ServicePulse",
  "license": "MIT",
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.23"
    }
  }
}
